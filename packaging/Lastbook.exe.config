<?xml version="1.0" encoding="utf-8"?>
<!-- Sits beside Lastbook.exe. Windows marks files that came from the internet, and .NET Framework then refuses to load
     the marked assemblies in the program folder: the window's own Python.Runtime.dll and the two WebView2 files.
     This switch is Microsoft's documented answer. It lets this one program load its own assemblies; Smart App Control and SmartScreen
     still judge the program as before. -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
